{
  "manifest_version": 3,
  "name": "Payload Inspector Pro",
  "version": "1.0.3",
  "description": "Nätverksinspektion med Heuristisk Säkerhetsdetektor och Network Kill Switch för att förhindra dataläckage.",
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Payload Inspector Pro"
  }
}